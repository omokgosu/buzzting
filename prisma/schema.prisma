// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Seed configuration
// Run: npm run db:seed

// ============================================
// Enums
// ============================================

enum UserRole {
  user
  admin
}

enum MatchRequestStatus {
  pending
  accepted
  rejected
  cancelled
}

enum MatchStatus {
  active
  completed
  cancelled
}


// ============================================
// Models
// ============================================

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  nickname      String
  name          String?
  department    String?
  emailVerified Boolean  @default(true) @map("email_verified")
  role          UserRole @default(user)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  profiles           Profile[] @relation("UserProfiles")
  registeredProfiles Profile[] @relation("RegisteredBy")

  @@index([email])
  @@index([createdAt])
  @@map("users")
}

model Profile {
  id             String  @id @default(uuid())
  userId         String  @map("user_id")
  registeredById String  @map("registered_by")
  nickname       String
  gender         String? // 성별 (male, female)
  character      String? // 캐릭터 아이콘 (fox, bear, wolf, rabbit, etc.)
  birthYear      Int?    @map("birth_year")
  bio            String? // 친구 소개글
  height         Int?
  mbti           String?
  location       String?
  job            String? // 직장/직업
  smoking        String? // 비흡연/흡연/가끔
  drinking       String? // 안마심/가끔/자주/소주1병 등

  // 복수선택 필드들
  interests     String[] @default([]) // 관심사
  idealTypes    String[] @default([]) @map("ideal_types") // 이상형
  dateStyles    String[] @default([]) @map("date_styles") // 데이트 스타일
  datingStyles  String[] @default([]) @map("dating_styles") // 연애 스타일
  contactStyles String[] @default([]) @map("contact_styles") // 연락 스타일

  contactPreference String? @map("contact_preference") // 카카오톡/전화/인스타DM/직접만남
  instagramUrl      String? @map("instagram_url") // 인스타그램 URL
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  // Relations
  user                  User           @relation("UserProfiles", fields: [userId], references: [id], onDelete: Cascade)
  registeredBy          User           @relation("RegisteredBy", fields: [registeredById], references: [id], onDelete: Cascade)
  matchRequestsSent     MatchRequest[] @relation("RequesterProfile")
  matchRequestsReceived MatchRequest[] @relation("TargetProfile")
  matchesAsProfile1     Match[]        @relation("Profile1")
  matchesAsProfile2     Match[]        @relation("Profile2")

  @@index([userId])
  @@index([registeredById])
  @@index([isActive])
  @@index([createdAt])
  @@map("profiles")
}

model MatchRequest {
  id                 String             @id @default(uuid())
  requesterProfileId String             @map("requester_profile_id")
  targetProfileId    String             @map("target_profile_id")
  status             MatchRequestStatus @default(pending)
  message            String?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  respondedAt        DateTime?          @map("responded_at")

  // Relations
  requesterProfile Profile @relation("RequesterProfile", fields: [requesterProfileId], references: [id], onDelete: Cascade)
  targetProfile    Profile @relation("TargetProfile", fields: [targetProfileId], references: [id], onDelete: Cascade)
  match            Match?

  @@unique([requesterProfileId, targetProfileId])
  @@index([requesterProfileId])
  @@index([targetProfileId])
  @@index([status])
  @@map("match_requests")
}

model Match {
  id             String      @id @default(uuid())
  matchRequestId String      @unique @map("match_request_id")
  profile1Id     String      @map("profile1_id")
  profile2Id     String      @map("profile2_id")
  status         MatchStatus @default(active)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  // Relations
  matchRequest MatchRequest @relation(fields: [matchRequestId], references: [id], onDelete: Cascade)
  profile1     Profile      @relation("Profile1", fields: [profile1Id], references: [id], onDelete: Cascade)
  profile2     Profile      @relation("Profile2", fields: [profile2Id], references: [id], onDelete: Cascade)

  @@unique([profile1Id, profile2Id])
  @@index([matchRequestId])
  @@index([profile1Id])
  @@index([profile2Id])
  @@index([status])
  @@map("matches")
}
